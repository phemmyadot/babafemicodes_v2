# Sanity project: babafemicodes_v2 (dishu3ld).
NEXT_PUBLIC_SANITY_PROJECT_ID=dishu3ld
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Read token (Viewer) used by the site
SANITY_API_TOKEN=

# Shared secret for the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# Editor token — only needed for `npm run migrate -- --apply`
SANITY_API_WRITE_TOKEN=

# Contact form (Arcade Radio Tower): Resend key with sending access.
RESEND_API_KEY=
# Optional: an address on a domain verified in Resend. Without it, onboarding@resend.dev is used and only the Resend account owner receives mail.
CONTACT_FROM=
