# Sanity project — same project/dataset as the original babafemi.codes site.
# Leave PROJECT_ID blank to run on the bundled fallback content in content/portfolio.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Read token (Viewer) used by the site
SANITY_API_TOKEN=

# Shared secret for the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# Editor token — only needed for `npm run migrate -- --apply`
SANITY_API_WRITE_TOKEN=
